
# Configuración general
DEVICE_ID=invernadero-01

# Broker MQTT
MQTT_HOST=
MQTT_PORT=8883
MQTT_USERNAME=
MQTT_PASSWORD=

# Base de datos
DATABASE_PATH=database/invernadero.db

# Adafruit IO
ADAFRUIT_IO_USERNAME=
ADAFRUIT_IO_KEY=

# Intervalo de lectura (segundos)
SENSOR_INTERVAL=5

# Límites de temperatura
TEMP_ON=30
TEMP_OFF=28

# Límites de luminosidad
LIGHT_ON=30
LIGHT_OFF=40